# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app-name>
MONGODB_DB_NAME=flowjob

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# For local HTTP false; set true when using HTTPS in production.
# Local HTTP only. Set true in production, including behind a TLS proxy. HTTPS always sets Secure.
COOKIE_SECURE=false

# --- OpenAI Job Matching (paid API) ---
# Leave OPENAI_API_KEY empty to keep AI matching disabled (endpoint returns 503, no calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_INPUT_PRICE_PER_1M=2.00
OPENAI_OUTPUT_PRICE_PER_1M=8.00
MATCH_DAILY_QUOTA=20
MATCH_JOB_DESCRIPTION_MIN_CHARS=80
MATCH_JOB_DESCRIPTION_MAX_CHARS=12000
MATCH_CACHE_TTL_HOURS=720

# --- Gmail integration (optional) ---
# Leave the Google client and token key empty to keep Gmail unavailable; every other feature works unchanged.
# Google Cloud OAuth "Web application" client (see README.md "Gmail integration"):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an Authorized redirect URI of the client exactly. The default goes through the Vite dev proxy.
# Production: https://<frontend host>/api/v1/gmail/oauth/callback, proxied to the backend on the SAME host as the
# frontend (the OAuth binding cookie is host-only), with COOKIE_SECURE=true. See README.md "Production configuration".
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/gmail/oauth/callback
# 32 random bytes, base64. Generate with: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Separate from JWT_SECRET. To rotate: move the old key to GMAIL_TOKEN_KEYS_OLD (comma-separated), set a new one.
GMAIL_TOKEN_KEY=
GMAIL_TOKEN_KEYS_OLD=
# Production: https://<frontend host>
FRONTEND_BASE_URL=http://localhost:5173
# In-process 3-hourly sync while the backend runs. Off by default (tests never start it). Also retries temporary
# Gmail failures with backoff and finishes interrupted disconnects. Safe on several processes (MongoDB lease).
GMAIL_SCHEDULER_ENABLED=false
GMAIL_SYNC_INTERVAL_HOURS=3
# AI classifications (paid): per user per UTC day, and a global cap separate from Match/Tailor.
GMAIL_DAILY_QUOTA=200
GMAIL_GLOBAL_DAILY_QUOTA=2000
# At most 50 candidates per batch and 4 batches per run (values above those are rejected).
GMAIL_BATCH_SIZE=50
GMAIL_MAX_BATCHES_PER_RUN=4

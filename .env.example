# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app-name>
MONGODB_DB_NAME=flowjob

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# For local HTTP false; set true when using HTTPS in production.
# Local HTTP only. Set true in production, including behind a TLS proxy. HTTPS always sets Secure.
COOKIE_SECURE=false

# --- OpenAI Job Matching (paid API) ---
# Leave OPENAI_API_KEY empty to keep AI matching disabled (endpoint returns 503, no calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_INPUT_PRICE_PER_1M=0.15
OPENAI_OUTPUT_PRICE_PER_1M=0.60
MATCH_DAILY_QUOTA=20
MATCH_JOB_DESCRIPTION_MIN_CHARS=80
MATCH_JOB_DESCRIPTION_MAX_CHARS=12000
MATCH_CACHE_TTL_HOURS=720

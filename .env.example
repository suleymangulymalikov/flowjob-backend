# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# These values match the defaults in docker-compose.yml (local development only).

# Used by docker-compose.yml to create the local database
POSTGRES_USER=flowjob
POSTGRES_PASSWORD=change_me
POSTGRES_DB=flowjob_dev
POSTGRES_TEST_DB=flowjob_test
POSTGRES_PORT=5432

# Used by the application and Alembic
DATABASE_URL=postgresql+psycopg://flowjob:change_me@localhost:5432/flowjob_dev
# Used only by the automated tests (must be a different database)
TEST_DATABASE_URL=postgresql+psycopg://flowjob:change_me@localhost:5432/flowjob_test
